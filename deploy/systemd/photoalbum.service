# Bare-metal / VM install: copy the binary to /usr/local/bin/photoalbum and
# this unit to /etc/systemd/system/, then: systemctl enable --now photoalbum
[Unit]
Description=photoalbum photo album
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/photoalbum serve
EnvironmentFile=-/etc/photoalbum/photoalbum.env
Environment=PHOTOALBUM_ADDR=:8092
Environment=PHOTOALBUM_DATA_DIR=/var/lib/photoalbum
DynamicUser=yes
StateDirectory=photoalbum
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
